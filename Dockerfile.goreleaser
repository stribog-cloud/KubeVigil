# Release-time container image: GoReleaser injects the prebuilt static binary.
# Source builds use ./Dockerfile; this file exists only for `goreleaser release`.
FROM gcr.io/distroless/static-debian12:nonroot

COPY kubevigil /usr/local/bin/kubevigil

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/kubevigil"]
