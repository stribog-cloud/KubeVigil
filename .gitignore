# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
/kubevigil
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Benchmark and profiling output
bench-*.txt
*.prof

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Scan results (live cluster output, may contain PII)
scan-results/

# Credentials and secrets
*.kubeconfig
*.pem
*.key
*.crt
*.token
*.secret

# E2E test runtime artifacts (ephemeral, not part of the test suite)
test/e2e/results/
test/e2e/clusters/*.local.yaml
test/e2e/third-party/kubernetes-goat/
test/e2e/third-party/microservices-demo/

# Internal engineering docs (specs, prompts, strategies — not for public repo)
docs/internal/

# AI agent instructions (local-only)
CLAUDE.md
CLAUDE-Phase*.md
AGENTS.md
.claude/



