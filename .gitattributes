# Prevent accidental binary commits — mark as binary (no diff, no merge)
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Ensure consistent line endings for text files
*.go text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf
Makefile text eol=lf
